# Salin file ini jadi ".env" lalu sesuaikan nilainya untuk mesin kamu.
# JANGAN commit file ".env" asli ke git (sudah ada di .gitignore) --
# hanya file ".env.example" ini yang boleh masuk repositori.

# --- LLM (Ollama, lokal) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=aya:8b
OLLAMA_TIMEOUT_SECONDS=120

# --- Chunking ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# --- OCR ---
OCR_MIN_TEXT_LEN=20
OCR_LANG=ind
OCR_DPI=300

# --- Retrieval ---
TOP_K_DEFAULT=5
RERANK_INITIAL_K=15

# --- Multi-turn context ---
MAX_HISTORY_TURNS=3

# --- Auth ---
# WAJIB diganti sebelum deploy/demo sidang -- jangan pakai nilai default ini.
JWT_SECRET=ganti-ini-dengan-random-string-yang-panjang-dan-acak
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Evaluasi RAGAS ---
RAGAS_JUDGE_MODEL=aya:8b
RAGAS_EMBEDDING_MODEL=e5_small

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
